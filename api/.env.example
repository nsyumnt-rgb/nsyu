PORT=5000
NODE_ENV=development

# Database configuration (PostgreSQL / Supabase or DATABASE_URL)
DB_DIALECT=postgres
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=your_db_username
DB_PASS=your_db_password
# Alternatively provide a complete connection string:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# JWT secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Allowed CORS origins (comma-separated for multiple origins)
ALLOWED_ORIGINS=https://nsyumnt-rgb.github.io,http://localhost:5173

# Never enable demo seed in production
ENABLE_DEMO_SEED=false
