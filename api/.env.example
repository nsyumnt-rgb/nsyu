PORT=5000
NODE_ENV=development

# Database configuration (Hostinger MySQL or PostgreSQL / Supabase)
# For Hostinger MySQL:
DB_DIALECT=mysql
DB_HOST=srv1952.hstgr.io
DB_PORT=3306
DB_NAME=u166803992_nsyu
DB_USER=u166803992_support
DB_PASS=your_db_password

# For PostgreSQL / Supabase:
# DB_DIALECT=postgres
# DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=your_db_username
# DB_PASS=your_db_password
# Alternatively provide a complete connection string:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# JWT secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Allowed CORS origins (comma-separated for multiple origins)
ALLOWED_ORIGINS=https://nsyu.in,https://www.nsyu.in,https://nsyumnt-rgb.github.io,http://localhost:5173

# Never enable demo seed in production
ENABLE_DEMO_SEED=false

# Image storage for product photos and shop banners (Supabase Storage).
# Required in production: Render's free-plan disk is wiped on every restart.
# Without these, dev/test save to ./uploads and production refuses uploads.
# Use the new Secret key (sb_secret_...) from Project Settings → API Keys (legacy
# service_role JWT keys also work until Supabase retires them in 2027).
# Server-side only — never put it in the web app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=nsyu-media

# ── WhatsApp + Email messaging (optional; each channel works on its own) ──
# Links inside messages (invoice, tracking, unsubscribe) point here
PUBLIC_WEB_URL=https://nsyu.in
# Public URL of this API, shown as the WhatsApp webhook URL in Messages › Channels
API_PUBLIC_URL=https://nsyu-backend-api.onrender.com
# Encrypts stored WhatsApp tokens (falls back to JWT_ACCESS_SECRET). Do not change once set.
MESSAGING_ENCRYPTION_KEY=
# Optional: one app secret / verify token for all shops (otherwise set per shop in the UI)
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Daily automations (due reminders, birthdays, festivals) run from this hour, local time
MESSAGING_TIMEZONE=Asia/Kolkata
MESSAGING_DAILY_HOUR=10
# Set to "off" to stop the background sender on this instance
MESSAGING_WORKER=on

# Email relay (Cloudflare Worker, relay/). Render free blocks SMTP ports.
EMAIL_RELAY_URL=https://nsyu-email-relay.nsyu-email-relay.workers.dev/send
EMAIL_RELAY_SECRET=
